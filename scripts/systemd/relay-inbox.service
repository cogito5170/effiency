# ~/.config/systemd/user/relay-inbox.service — codex 로그인이 된 사용자 계정으로 실행한다 (systemctl --user).
[Unit]
Description=relay inbox: run codex/agy requests that arrive through git

[Service]
Type=oneshot
# relay 와 codex/agy 가 PATH 에 있어야 한다. 경로는 VM 에 맞게 고친다.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# --repo 를 반복하면 여러 저장소를 본다. 클론이 없는 저장소는 건너뛴다 (docs/vm-inbox.md).
ExecStart=%h/.local/bin/relay inbox --repo %h/relay-inbox/repo --repo %h/relay-inbox/gentleMonster
TimeoutStartSec=2h
